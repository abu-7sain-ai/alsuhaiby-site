{
  "name": "alsuhaiby-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "analyze": "node scripts/analyze.js",
    "write": "node scripts/write.js",
    "review": "node scripts/review.js",
    "build-pages": "node scripts/build-page.js",
    "deploy": "astro build && wrangler deploy",
    "status": "node scripts/lib/status.js",
    "night": "node scripts/night.js",
    "fetch": "node scripts/fetch.js",
    "numbers": "node scripts/meta.js --part=numbers",
    "comments": "node scripts/meta.js --part=comments",
    "daily": "node scripts/daily.js",
    "test": "node --test scripts/test-publishable.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
