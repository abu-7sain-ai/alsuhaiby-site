---
import Base from '../layouts/Base.astro';
import { PERSON, SOCIAL } from '../i18n';
const P = PERSON.ar;
// Workshop WhatsApp number: placeholder until Mohammad provides it (only the workshop number is published, never a personal one).
const WHATSAPP = '';
---
<Base lang="ar" title="تواصل" description={`تواصل مع ${P.garage} عن طريق واتساب الكراج، أو تابع ${P.name} على تيك توك وانستقرام.`} path="/contact/" current="contact">
  <div class="wrap article">
    <h1 class="ptitle">تواصل</h1>
    <h2>واتساب الكراج</h2>
    {WHATSAPP
      ? <p><a class="btn" href={`https://wa.me/${WHATSAPP}`} rel="noopener">راسل {P.garage} على واتساب</a></p>
      : <p class="note">رقم واتساب الكراج: يُضاف قريبًا.</p>}
    <h2>الحسابات</h2>
    <ul>
      <li><a href={SOCIAL.tiktok} rel="me">تيك توك</a></li>
      <li><a href={SOCIAL.instagram} rel="me">انستقرام</a></li>
    </ul>
  </div>
</Base>
