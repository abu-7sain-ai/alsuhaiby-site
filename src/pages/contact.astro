---
import Base from '../layouts/Base.astro';
import GarageContact from '../components/GarageContact.astro';
import { PERSON, SOCIAL, garageLd } from '../i18n';
const P = PERSON.ar;
const jsonLd = [{ '@context': 'https://schema.org', ...garageLd('ar') }];
---
<Base lang="ar" title="تواصل" description={`تواصل مع ${P.garage} عن طريق واتساب الكراج أو زوره في الشويخ الصناعية، أو تابع ${P.name} على تيك توك وانستقرام.`} path="/contact/" jsonLd={jsonLd} current="contact">
  <div class="wrap article">
    <h1 class="ptitle">تواصل</h1>
    <GarageContact />
    <h2>الحسابات</h2>
    <ul>
      <li><a href={SOCIAL.tiktok} rel="me">تيك توك</a></li>
      <li><a href={SOCIAL.instagram} rel="me">انستقرام</a></li>
    </ul>
  </div>
</Base>
