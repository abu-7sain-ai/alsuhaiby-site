---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Player from './Player.astro';
import Card from './Card.astro';
import { t, videoUrl, formatDate, formatViews, SITE, PERSON, SOCIAL, type Lang } from '../i18n';

interface Props { entry: CollectionEntry<'videos'> }
const { entry } = Astro.props;
const d = entry.data;
const lang = d.lang as Lang;
const u = t(lang);
const { Content } = await render(entry);

const all = await getCollection('videos', (e) => e.data.lang === lang);
const alternates = (await getCollection('videos', (e) => e.data.topic === d.topic)).map((e) => ({ lang: e.data.lang as Lang, url: videoUrl(e.data.lang as Lang, e.data.slug) }));
const others = all.filter((e) => e.data.topic !== d.topic);
const related = [
  ...others.filter((e) => e.data.system === d.system),
  ...others.filter((e) => e.data.system !== d.system && e.data.tags.some((x) => d.tags.includes(x))),
  ...others.filter((e) => e.data.system !== d.system).sort((a, b) => b.data.views - a.data.views),
].filter((e, i, arr) => arr.indexOf(e) === i).slice(0, 4);

const path = videoUrl(lang, d.slug);
const abs = (p: string) => new URL(p, SITE).href;
const iso = (s?: number) => (s ? `PT${Math.floor(s / 60) ? Math.floor(s / 60) + 'M' : ''}${s % 60}S` : undefined);
const person = {
  '@type': 'Person', '@id': `${SITE}/about/#person`, name: PERSON[lang].name, jobTitle: PERSON[lang].job,
  worksFor: { '@type': 'AutoRepair', name: PERSON[lang].garage, address: { '@type': 'PostalAddress', addressCountry: 'KW' } },
  url: `${SITE}/about/`, sameAs: [SOCIAL.tiktok, SOCIAL.instagram],
};
const videoLd = (id: string, name: string, cover: string, date: Date, views: number, duration?: number) => ({
  '@type': 'VideoObject', name, description: d.summary, thumbnailUrl: [abs(cover)], uploadDate: date.toISOString(),
  ...(duration ? { duration: iso(duration) } : {}),
  embedUrl: `https://www.tiktok.com/player/v1/${id}`, url: `https://www.tiktok.com/@m_alsuhaiby/video/${id}`, inLanguage: lang,
  interactionStatistic: { '@type': 'InteractionCounter', interactionType: { '@type': 'WatchAction' }, userInteractionCount: views },
  author: { '@id': person['@id'] },
});
const jsonLd = [
  { '@context': 'https://schema.org', ...videoLd(d.tiktokId, d.title, d.cover, d.published, d.views, d.duration) },
  ...(d.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
  { '@context': 'https://schema.org', ...person },
];
---
<Base lang={lang} title={d.title} description={d.description} path={path} alternates={alternates} ogImage={d.ogImage} ogType="article" jsonLd={jsonLd} preloadImage={d.cover}>
  <article class="wrap">
    <h1 class="ptitle">{d.title}</h1>
    <div class="answer"><p>{d.summary}</p></div>
    <Player id={d.tiktokId} cover={d.cover} title={d.title} lang={lang} eager />
    <p class="platforms">
      <span>{u.otherPlatforms}:</span>
      <a href={d.platforms.tiktok} rel="noopener">TikTok</a>
      {d.platforms.instagram && <a href={d.platforms.instagram} rel="noopener">Instagram</a>}
      {d.platforms.youtube && <a href={d.platforms.youtube} rel="noopener">YouTube</a>}
      <span>· {formatViews(d.views, lang)} {u.views}</span>
    </p>
    <div class="tags">{d.tags.map((x) => <a class="tag" href={`/topics/#${encodeURIComponent(x)}`}>{x}</a>)}</div>

    <div class="article"><Content /></div>

    {d.faq.length > 0 && (
      <section class="faq">
        <h2 class="sechead">{u.faq}</h2>
        {d.faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </section>
    )}

    {d.otherVideos.length > 0 && (
      <section>
        <h2 class="sechead">{u.otherVideos}</h2>
        <div class="grid">
          {d.otherVideos.map((v) => (
            <div>
              <Player id={v.tiktokId} cover={v.cover} title={v.title} lang={lang} />
              <p class="meta" style="text-align:center">{formatViews(v.views, lang)} {u.views} · {formatDate(v.published, lang)}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section>
        <h2 class="sechead">{u.related}</h2>
        <div class="grid">{related.map((e) => <Card lang={lang} slug={e.data.slug} title={e.data.title} cover={e.data.cover} views={e.data.views} />)}</div>
      </section>
    )}

    <p class="dates">
      <span>{u.published}: <time datetime={d.published.toISOString().slice(0, 10)}>{formatDate(d.published, lang)}</time></span>
      <span>{u.updated}: <time datetime={d.updated.toISOString().slice(0, 10)}>{formatDate(d.updated, lang)}</time></span>
    </p>
  </article>
</Base>
