---
// Clean player: Mohammad's own MP4 from Cloudflare R2 (media.alsuhaiby.com), no TikTok UI.
// Cover as poster, browser controls only, no autoplay, nothing downloaded until the visitor presses play.
import { videoSrc, type Lang } from '../i18n';
interface Props { id: string; cover: string; title: string; lang: Lang; eager?: boolean }
const { id, cover, title } = Astro.props;
---
<div class="player">
  <video controls preload="none" playsinline poster={cover} width="576" height="1024" aria-label={title} controlslist="nodownload noplaybackrate" disablepictureinpicture>
    <source src={videoSrc(id)} type="video/mp4" />
  </video>
</div>
