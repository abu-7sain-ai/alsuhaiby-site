---
import { videoUrl, formatViews, t, type Lang } from '../i18n';
interface Props { lang: Lang; slug: string; title: string; cover: string; views: number }
const { lang, slug, title, cover, views } = Astro.props;
---
<a class="card" href={videoUrl(lang, slug)}>
  <img src={cover} alt="" width="576" height="768" loading="lazy" decoding="async" />
  <span class="t">{title}</span>
  <span class="m">{formatViews(views, lang)} {t(lang).views}</span>
</a>
