{
  // Deployed by Cloudflare Workers Builds on every push to main (build: npm run build, deploy: npx wrangler deploy).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alsuhaiby-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "alsuhaiby.com", "custom_domain": true },
    { "pattern": "www.alsuhaiby.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
